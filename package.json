{
  "name": "link-api-docs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "icons:generate": "node scripts/generate-icons.mjs",
    "dev": "concurrently -k -n api,web -c magenta,cyan \"tsx watch server/index.ts\" \"vite\"",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.server.json && node scripts/copy-pdf-assets.mjs",
    "seed:content": "node scripts/seed-content.mjs",
    "start": "node dist/server/index.js",
    "db:migrate": "tsx server/scripts/migrate.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^9.2.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.2",
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@vueuse/core": "^13.6.0",
    "argon2": "^0.44.0",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.2.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.4.0",
    "highlight.js": "^11.11.1",
    "lucide": "^0.536.0",
    "lucide-vue-next": "^0.536.0",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-container": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "mysql2": "^3.14.3",
    "pdfmake": "0.2.23",
    "pg": "^8.23.1",
    "pinia": "^3.0.3",
    "sanitize-html": "^2.17.0",
    "sharp": "^0.35.3",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1",
    "vuedraggable": "^4.1.0",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@types/markdown-it": "^14.1.2",
    "@types/markdown-it-container": "^2.0.10",
    "@types/node": "^24.1.0",
    "@types/pdfmake": "0.2.13",
    "@types/pg": "^8.23.1",
    "@types/sanitize-html": "^2.16.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "concurrently": "^9.2.0",
    "jsdom": "^26.1.0",
    "pdfjs-dist": "^6.5.438",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^7.0.6",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.4"
  }
}
