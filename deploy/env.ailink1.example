NODE_ENV=production
HOST=127.0.0.1
PORT=8090
APP_ORIGIN=https://docs.ailink1.com
DEFAULT_SITE_NAME=Link API 文档
DEFAULT_SITE_SUBTITLE=AI API 接入与使用指南
DEFAULT_CONSOLE_URL=https://ai.ailink1.com
DEFAULT_ACCENT_COLOR="#6d4aff"
FRAME_ANCESTORS=https://ai.ailink1.com

# 独立教程数据库，不使用监控项目的数据库。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=docs_ailink1
DB_PASSWORD=replace-with-a-strong-password
DB_NAME=docs_ailink1
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
UPLOAD_DIR=/app/data/uploads
MAX_UPLOAD_MB=10

# 144 本机 Sub2API 的只读 PostgreSQL 与价格文件。
SUB2API_DATABASE_URL=postgresql://sub2api:replace-with-sub2api-password@127.0.0.1:5432/sub2api
SUB2API_PRICING_PATH=/opt/llm/sub2api-deploy/data/model_pricing.json
MODEL_SYNC_ENABLED=true
